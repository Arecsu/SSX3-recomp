+             " | PMC %08X PGRAPH_INTR %08X NSOURCE %08X TRAPPED %08X/%08X",
+             (long)g_nv2a_swm_pending,
+             g_nv2a_swm_raised_ms ? (long long)GetTickCount64() - g_nv2a_swm_raised_ms : -1LL,
