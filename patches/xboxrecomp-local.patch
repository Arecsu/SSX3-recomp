diff --git a/src/video/gpu_present.c b/src/video/gpu_present.c
new file mode 100644
index 0000000..d243871
--- /dev/null
+++ b/src/video/gpu_present.c
@@ -0,0 +1,105 @@
+/*
+ * D3D11 presentation for the framebuffer window (ROADMAP Phase 2.1).
+ *
+ * The window used to show each frame with GDI (StretchDIBits on a 16 ms
+ * timer). This puts a D3D11 device and a swap chain on the same window and
+ * presents the flipped frame through it, vsync-paced -- the device the GPU
+ * renderer will later draw into directly instead of copying from guest
+ * memory. The frame is uploaded straight into the back buffer (same size,
+ * B8G8R8A8: the guest's A8R8G8B8 in memory order); DXGI stretches it to the
+ * window. RECOMP_D3D_PRESENT=1 turns it on; anything that fails falls back to
+ * GDI.
+ */
+#if defined(_WIN32)
+#define COBJMACROS
+#include <windows.h>
+#include <d3d11.h>
+#include <dxgi.h>
+#include <stdio.h>
+#include <stdint.h>
+#include <stdlib.h>
+#include "gpu_present.h"
+
+#pragma comment(lib, "d3d11.lib")
+#pragma comment(lib, "dxgi.lib")
+
+static ID3D11Device        *s_dev;
+static ID3D11DeviceContext *s_ctx;
+static IDXGISwapChain      *s_chain;
+static ID3D11Texture2D     *s_back;
+static uint32_t             s_w, s_h;
+static int                  s_vsync = 1;
+
+int gpu_present_enabled(void)
+{
+    static int on = -1;
+    if (on < 0) {
+        const char *e = getenv("RECOMP_D3D_PRESENT");
+        on = e && *e && *e != '0';
+    }
+    return on;
+}
+
+int gpu_present_init(HWND hwnd, uint32_t width, uint32_t height)
+{
+    DXGI_SWAP_CHAIN_DESC sd;
+    HRESULT hr;
+    const char *v = getenv("RECOMP_VSYNC");
+
+    if (v && v[0] == '0')
+        s_vsync = 0;
+    ZeroMemory(&sd, sizeof sd);
+    sd.BufferDesc.Width  = width;
+    sd.BufferDesc.Height = height;
+    sd.BufferDesc.Format = DXGI_FORMAT_B8G8R8A8_UNORM;
+    sd.SampleDesc.Count  = 1;
+    sd.BufferUsage       = DXGI_USAGE_RENDER_TARGET_OUTPUT;
+    sd.BufferCount       = 1;
+    sd.OutputWindow      = hwnd;
+    sd.Windowed          = TRUE;
+    sd.SwapEffect        = DXGI_SWAP_EFFECT_DISCARD;
+
+    hr = D3D11CreateDeviceAndSwapChain(NULL, D3D_DRIVER_TYPE_HARDWARE, NULL, 0,
+                                       NULL, 0, D3D11_SDK_VERSION, &sd,
+                                       &s_chain, &s_dev, NULL, &s_ctx);
+    if (FAILED(hr)) {
+        fprintf(stderr, "  [D3D] device/swap chain failed (0x%08lX); staying on GDI\n",
+                (unsigned long)hr);
+        return 0;
+    }
+    hr = IDXGISwapChain_GetBuffer(s_chain, 0, &IID_ID3D11Texture2D, (void **)&s_back);
+    if (FAILED(hr)) {
+        fprintf(stderr, "  [D3D] no back buffer (0x%08lX); staying on GDI\n",
+                (unsigned long)hr);
+        gpu_present_shutdown();
+        return 0;
+    }
+    s_w = width;
+    s_h = height;
+    fprintf(stderr, "  [D3D] presenting through D3D11 (%ux%u, vsync %s)\n",
+            width, height, s_vsync ? "on" : "off");
+    return 1;
+}
+
+void gpu_present_frame(const uint32_t *pixels)
+{
+    if (!s_back || !pixels)
+        return;
+    ID3D11DeviceContext_UpdateSubresource(s_ctx, (ID3D11Resource *)s_back, 0,
+                                          NULL, pixels, s_w * 4, 0);
+    IDXGISwapChain_Present(s_chain, (UINT)s_vsync, 0);
+}
+
+void gpu_present_shutdown(void)
+{
+    if (s_back)  { ID3D11Texture2D_Release(s_back);      s_back = NULL; }
+    if (s_chain) { IDXGISwapChain_Release(s_chain);       s_chain = NULL; }
+    if (s_ctx)   { ID3D11DeviceContext_Release(s_ctx);    s_ctx = NULL; }
+    if (s_dev)   { ID3D11Device_Release(s_dev);           s_dev = NULL; }
+}
+
+int gpu_present_active(void)
+{
+    return s_back != NULL;
+}
+#endif
